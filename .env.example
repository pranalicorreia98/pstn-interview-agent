# =============================================================================
# PSTN Interview Agent Configuration
# =============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# =============================================================================
# Supabase Configuration
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Configuration
DB_TABLE_NAME=interviews
DB_SCHEMA=public
FETCH_WINDOW_MINUTES=5

# =============================================================================
# LiveKit Configuration
# Get these from: livekit.io → Dashboard → Settings → API Keys
# =============================================================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxx

# SIP Trunk ID (created in LiveKit with Vobiz credentials)
# Get this after configuring the trunk in LiveKit Dashboard → Telephony → Trunks
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxx

# =============================================================================
# Vobiz Configuration (India SIP Trunk Provider)
# Get these from: vobiz.ai → Console → SIP Trunk → Outbound Trunks
#
# Vobiz handles DLT/TRAI compliance automatically.
# Pricing: ₹0.45/min for India calls
# =============================================================================

# Your Vobiz SIP domain (e.g., your_domain.sip.vobiz.ai)
VOBIZ_SIP_DOMAIN=your_domain.sip.vobiz.ai

# Your Vobiz phone number for caller ID (E.164 format)
VOBIZ_CALLER_ID=+91xxxxxxxxxx

# Note: Vobiz username/password are configured in LiveKit trunk, not here

# =============================================================================
# AI Services
# =============================================================================

# Deepgram STT Configuration
# Get from: deepgram.com → Dashboard → API Keys
DEEPGRAM_API_KEY=your-deepgram-api-key

# DeepSeek LLM Configuration — same key and model as the Zoom bot
# (clikhireBotIntegration: Secret clikhire-bot-secrets / DEEPSEEK_API_KEY)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Google Cloud TTS — same REST API key as the Zoom bot (GOOGLE_TTS_API_KEY)
GOOGLE_TTS_API_KEY=your-google-tts-api-key
# Alternative: service account instead of an API key
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# =============================================================================
# Interview Settings
# =============================================================================
INTERVIEW_DURATION_MINUTES=30
VOICE_AGENT_MAX_DURATION_MINUTES=35
VOICE_AGENT_INACTIVITY_TIMEOUT_MINUTES=10
# Completed phone interviews older than this are not swept for missing transcripts
TRANSCRIPT_RECOVERY_HOURS=24

# =============================================================================
# Call Settings
# =============================================================================
MAX_CONCURRENT_CALLS=3
# How long the candidate's phone rings before the call counts as not answered
CALL_RINGING_TIMEOUT_SECONDS=45

# Business Hours (TRAI compliance for India)
# Calls only allowed during these hours in the specified timezone
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=21
BUSINESS_HOURS_TIMEZONE=Asia/Kolkata

# =============================================================================
# Cron Configuration
# =============================================================================
CRON_INTERVAL_MINUTES=1

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
