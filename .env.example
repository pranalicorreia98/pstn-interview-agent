# =============================================================================
# PSTN Interview Agent Configuration
# =============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Configuration
DB_TABLE_NAME=interviews
DB_SCHEMA=public
FETCH_WINDOW_MINUTES=5

# LiveKit Configuration (Cloud or self-hosted)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=your-sip-trunk-id

# Deepgram STT Configuration
DEEPGRAM_API_KEY=your-deepgram-api-key

# DeepSeek LLM Configuration
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Google Cloud TTS Configuration
# Path to service account JSON credentials
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Or inline credentials for containerized deployments
# GOOGLE_TTS_CREDENTIALS={"type":"service_account",...}

# Interview Duration & Timeouts
INTERVIEW_DURATION_MINUTES=30
VOICE_AGENT_MAX_DURATION_MINUTES=35
VOICE_AGENT_INACTIVITY_TIMEOUT_MINUTES=2

# Call Settings
MAX_CONCURRENT_CALLS=3
CALL_RETRY_DELAY_MINUTES=30
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=21
BUSINESS_HOURS_TIMEZONE=Asia/Kolkata

# Cron Configuration
CRON_INTERVAL_MINUTES=1

# Logging
LOG_LEVEL=info
